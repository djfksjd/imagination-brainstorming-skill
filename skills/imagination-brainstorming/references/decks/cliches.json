{
  "deck": "cliches",
  "version": "0.1.1",
  "note": "Default forbidden moves for concept work. 'ban' entries fail the lint (exit 3); 'warn' entries are reported only. Release a term with --allow <id> when the user genuinely asked for it - the point is that using it becomes a decision rather than a default. These are pitch-deck reflexes: words that claim a property instead of demonstrating it.",
  "hollow_adjectives": {
    "ban": ["seamless", "frictionless", "revolutionary", "game-changing", "cutting-edge", "next-generation", "best-in-class", "world-class", "state-of-the-art", "innovative", "disruptive", "groundbreaking", "effortless", "magical", "delightful", "turnkey", "holistic", "synergistic", "unparalleled"],
    "warn": ["intuitive", "robust", "scalable", "powerful", "simple", "elegant", "curated", "bespoke", "immersive", "unique", "smart"],
    "why": "Each of these asserts a quality the concept has not yet earned. If the sentence collapses when the adjective is removed, the adjective was carrying the concept."
  },
  "phrases": [
    { "id": "one-stop-shop", "phrase": "one-stop shop", "group": "pitch-reflex", "tier": "ban" },
    { "id": "single-source-of-truth", "phrase": "single source of truth", "group": "pitch-reflex", "tier": "warn" },
    { "id": "low-hanging-fruit", "phrase": "low-hanging fruit", "group": "pitch-reflex", "tier": "ban" },
    { "id": "move-the-needle", "phrase": "move the needle", "group": "pitch-reflex", "tier": "ban" },
    { "id": "north-star", "phrase": "north star", "group": "pitch-reflex", "tier": "warn" },
    { "id": "secret-sauce", "phrase": "secret sauce", "group": "pitch-reflex", "tier": "ban" },
    { "id": "10x", "phrase": "10x", "group": "pitch-reflex", "tier": "ban" },
    { "id": "paradigm-shift", "phrase": "paradigm shift", "group": "pitch-reflex", "tier": "ban" },
    { "id": "democratize", "phrase": "democratize", "group": "pitch-reflex", "tier": "ban" },
    { "id": "supercharge", "phrase": "supercharge", "group": "pitch-reflex", "tier": "ban" },
    { "id": "unlock-value", "phrase": "unlock value", "group": "pitch-reflex", "tier": "ban" },
    { "id": "leverage-synergies", "phrase": "leverage synergies", "group": "pitch-reflex", "tier": "ban" },
    { "id": "empower-users", "phrase": "empower users", "group": "pitch-reflex", "tier": "ban" },
