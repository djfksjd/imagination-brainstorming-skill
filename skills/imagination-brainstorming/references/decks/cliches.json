    { "id": "ai-driven", "phrase": "AI-driven", "group": "tech-veneer", "tier": "ban" },
    { "id": "blockchain-based", "phrase": "blockchain-based", "group": "tech-veneer", "tier": "ban" },
    { "id": "cloud-native", "phrase": "cloud-native", "group": "tech-veneer", "tier": "warn" },
    { "id": "smart-assistant", "phrase": "smart assistant", "group": "tech-veneer", "tier": "ban" },
    { "id": "personalized-feed", "phrase": "personalized feed", "group": "product-default", "tier": "warn" },
    { "id": "gamification", "phrase": "gamification", "group": "product-default", "tier": "ban" },
    { "id": "leaderboard", "phrase": "leaderboard", "group": "product-default", "tier": "warn" },
    { "id": "streaks", "phrase": "streak", "group": "product-default", "tier": "warn" },
    { "id": "badges", "phrase": "badge", "group": "product-default", "tier": "warn" },
    { "id": "chatbot", "phrase": "chatbot", "group": "product-default", "tier": "warn" },
    { "id": "dashboard-kpi", "phrase": "KPI dashboard", "group": "product-default", "tier": "ban" },
    { "id": "marketplace-two-sided", "phrase": "two-sided marketplace", "group": "product-default", "tier": "warn" },
    { "id": "social-network-for", "phrase": "social network for", "group": "product-default", "tier": "ban" },
    { "id": "netflix-for", "phrase": "Netflix for", "group": "named-analogy", "tier": "ban" },
    { "id": "uber-for", "phrase": "Uber for", "group": "named-analogy", "tier": "ban" },
    { "id": "airbnb-for", "phrase": "Airbnb for", "group": "named-analogy", "tier": "ban" },
    { "id": "the-x-of-y", "phrase": "the Spotify of", "group": "named-analogy", "tier": "ban" },
    { "id": "operating-system-for", "phrase": "operating system for", "group": "named-analogy", "tier": "ban" },
    { "id": "swiss-army-knife", "phrase": "Swiss army knife", "group": "named-analogy", "tier": "warn" }
  ],
  "structural_patterns": [
    { "id": "x-for-y", "regex": "\\b(?:the )?(?:Uber|Netflix|Airbnb|Spotify|Tinder|Slack|Notion|Figma|Duolingo)\\s+(?:for|of)\\b", "tier": "ban", "why": "The concept is being defined as an existing company applied to a new noun. Nothing here is yours." },
    { "id": "x-meets-y", "regex": "\\b(?:it'?s|it is|this is|basically|essentially|think of it as|kind of)\\s+(?:like\\s+)?[A-Za-z]+\\s+meets\\s+[A-Za-z]+\\b", "tier": "ban", "why": "Two known things joined by a verb, offered as the explanation. Narrowed to the pitch frame on purpose: in a story brief, 'Alice meets Bob at the station' is a scene, not a cliche." },
    { "id": "cross-between", "regex": "\\bcross between\\b", "tier": "ban", "why": "The same failure, stated more honestly." },
    { "id": "mix-of", "regex": "\\b(?:a )?(?:mix|blend|fusion|mashup|combination) of\\b", "tier": "warn", "why": "Announces assembly. The parts should have stopped being separable." },
    { "id": "but-for", "regex": "\\bbut (?:with|for) (?:AI|blockchain|kids|enterprise|B2B)\\b", "tier": "ban", "why": "An existing product with a segment attached is a positioning, not a concept." },
    { "id": "users-will-love", "regex": "\\busers? will (?:love|enjoy|appreciate)\\b", "tier": "warn", "why": "An assertion about reception standing in for a property of the design." },
    { "id": "simply-just", "regex": "\\b(?:simply|just) (?:works|use|add)\\b", "tier": "warn", "why": "'Simply' marks the place where the hard part was skipped." },
    { "id": "everyone-is-user", "regex": "\\b(?:for )?(?:everyone|anyone who|all users)\\b", "tier": "warn", "why": "No audience has been chosen; boundaries are what make a concept designable." },
    { "id": "in-the-future", "regex": "\\bin the (?:near |far |distant )?future\\b", "tier": "warn", "why": "Moving the clock forward is not a premise change." }
  ],
  "moves": [
    "Presenting three approaches where two exist only to make the third look reasonable.",
    "Answering a premise question with a requirement, leaving the premise untouched.",
    "Adding a feature in response to every concern until the concept has no shape.",
    "Naming a familiar pattern with a new word and treating the word as the design.",
    "Deciding what to build before establishing what it will refuse to do.",
    "Writing a concept with no open questions, which means the unknowns were hidden rather than resolved.",
    "Letting the recommended option be the only one described in enough detail to judge.",
    "Converging on the first idea the user showed enthusiasm for, before the premises were tested.",
    "Treating an analogy to an existing company as an explanation of the mechanism.",
    "Deferring every hard decision to 'we'll validate that with users'."
  ]
}
